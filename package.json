{
  "name": "secure-clinic-system",
  "version": "1.0.0",
  "description": "Secure clinic appointment system - Web Security Midterm Project",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "server": "node server/index.js",
    "audit": "npm audit --json > security-audit-report.json && npm audit"
  },
  "keywords": ["security", "clinic", "healthcare", "appointment"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "cookie-parser": "^1.4.6",
    "morgan": "^1.10.0",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "dompurify": "^3.0.8"
  }
}
